[Unit]
Description=Run the AFS options coverage collector after the New York close (weekdays; the collector skips holidays and handles early closes itself)

[Timer]
# 16:35 ET = regular close + 35 min (> the collector's 30-min settle buffer).
# Early-close days (13:00 ET) settle long before this; holidays resolve to SKIPPED inside the collector.
OnCalendar=Mon..Fri *-*-* 16:35:00 America/New_York
# A missed firing (box down at 16:35) runs at the next boot; the collector then
# resolves the newest settled session itself and is idempotent if already collected.
Persistent=true
AccuracySec=1min
Unit=afs-coverage-collector.service

[Install]
WantedBy=timers.target
