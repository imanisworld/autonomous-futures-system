[Unit]
Description=AFS day-only 4PM exit fallback
After=network.target futures-bot.service

[Service]
Type=oneshot
WorkingDirectory=/root/autonomous-futures-system
EnvironmentFile=/root/afs-shared/.env
ExecStart=/root/autonomous-futures-system/.venv/bin/python /root/autonomous-futures-system/scripts/day_only_exit_scheduler.py
StandardOutput=journal
StandardError=journal
