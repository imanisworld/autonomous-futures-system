[Unit]
Description=AFS day-only 4PM exit fallback
After=network.target futures-bot.service

[Service]
Type=oneshot
WorkingDirectory=/root/afs-shared/current
EnvironmentFile=/root/afs-shared/.env
ExecStart=/root/afs-shared/current/.venv/bin/python /root/afs-shared/current/scripts/day_only_exit_scheduler.py
StandardOutput=journal
StandardError=journal
