[Unit]
Description=AFS wide-stop Tradovate DEMO 4PM exit fallback
After=network.target futures-bot.service

[Service]
Type=oneshot
WorkingDirectory=/root/autonomous-futures-system
EnvironmentFile=/root/afs-shared/.env
ExecStart=/root/autonomous-futures-system/.venv/bin/python -m scripts.wide_stop_demo_eod_fallback
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
