//@version=6
indicator("RiskSentinel - Full Context", overlay=true)

// INPUTS
i_orb_min = input.int(15, "ORB Window (min)", minval=5, maxval=60, step=5, group="Opening Range")
i_ny_session = input.session("0930-1200", "NY Session (ET)", group="Opening Range")
i_london_session = input.session("0300-0830", "London Session (ET)", group="Opening Range")
i_ema_fast = input.int(9, "Fast EMA", minval=2, group="Trend")
i_ema_slow = input.int(21, "Slow EMA", minval=5, group="Trend")
i_vol_len = input.int(20, "Volume MA", minval=5, group="Volume")
i_alert_on = input.bool(true, "Fire alert on every confirmed bar close", group="Alert")

// Manual context inputs for gates. Keep blank/na when unavailable; webhook treats missing data as neutral.
i_gex_flip = input.float(na, "GEX Flip", group="GEX / Gamma")
i_call_wall = input.float(na, "Call Wall", group="GEX / Gamma")
i_put_wall = input.float(na, "Put Wall", group="GEX / Gamma")
i_hvl = input.float(na, "HVL", group="GEX / Gamma")
i_max_pain = input.float(na, "Max Pain", group="GEX / Gamma")
i_mid_upper = input.float(na, "Mid Upper", group="GEX / Gamma")
i_mid_lower = input.float(na, "Mid Lower", group="GEX / Gamma")
i_vol_trigger_up = input.float(na, "Vol Trigger Up", group="GEX / Gamma")
i_vol_trigger_down = input.float(na, "Vol Trigger Down", group="GEX / Gamma")
i_gex_regime = input.string("", "GEX Regime", group="GEX / Gamma")
i_delta_bias = input.string("", "Delta Bias", group="GEX / Gamma")

i_signa_grade = input.string("", "Signa Grade", group="Signa")
i_signa_score = input.float(na, "Signa Score", group="Signa")
i_signa_daily_direction = input.string("", "Signa Daily Direction", group="Signa")
i_signa_weekly_direction = input.string("", "Signa Weekly Direction", group="Signa")

i_supply_top = input.float(na, "Supply Zone Top", group="Supply / Demand")
i_supply_bottom = input.float(na, "Supply Zone Bottom", group="Supply / Demand")
i_supply_wavg = input.float(na, "Supply Zone WAVG", group="Supply / Demand")
i_demand_top = input.float(na, "Demand Zone Top", group="Supply / Demand")
i_demand_bottom = input.float(na, "Demand Zone Bottom", group="Supply / Demand")
i_demand_wavg = input.float(na, "Demand Zone WAVG", group="Supply / Demand")

// HELPERS
f2j(v, fmt) => na(v) ? "null" : str.tostring(v, fmt)
s2j(v) => na(v) or v == "" ? "null" : '"' + v + '"'

classify_bar(h, l, ph, pl) =>
    if na(ph) or na(pl)
        "unknown"
    else
        bh = h > ph
        bl = l < pl
        if bh and bl
            "outside_bar"
        else if not bh and not bl
            "inside_bar"
        else if bh
            "two_up"
        else
            "two_down"

orb_status_for(orb_high, orb_low) =>
    if na(orb_high) or na(orb_low)
        "undefined"
    else if close > orb_high and close[1] <= orb_high
        "reclaimed_high"
    else if close < orb_low and close[1] >= orb_low
        "reclaimed_low"
    else if close[1] > orb_high and close <= orb_high
        "rejected_high"
    else if close[1] < orb_low and close >= orb_low
        "rejected_low"
    else if close > orb_high
        "above"
    else if close < orb_low
        "below"
    else
        "inside"

// CORE CALCULATIONS
ema_fast = ta.ema(close, i_ema_fast)
ema_slow = ta.ema(close, i_ema_slow)
vwap_val = ta.vwap(hlc3)
avg_vol = ta.sma(volume, i_vol_len)
rel_vol = avg_vol > 0 ? volume / avg_vol : 1.0

[pd_high, pd_low, pd_close] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)

// TREND (declare variables first)
var string trend_dir = "SIDEWAYS"
var string trend_str = "WEAK"

diff_pct = math.abs(ema_fast - ema_slow) / ema_slow * 100
if ema_fast > ema_slow and diff_pct > 0.15
    trend_dir := "UP"
else if ema_fast < ema_slow and diff_pct > 0.15
    trend_dir := "DOWN"
else
    trend_dir := "SIDEWAYS"

if diff_pct > 0.40
    trend_str := "STRONG"
else if diff_pct > 0.15
    trend_str := "MODERATE"
else
    trend_str := "WEAK"

// NY ORB
bars_needed = math.max(1, math.round(i_orb_min * 60 / timeframe.in_seconds()))
in_ny = not na(time(timeframe.period, i_ny_session, "America/New_York"))
ny_start = in_ny and not in_ny[1]

var float orb_h = na
var float orb_l = na
var int orb_cnt = 0
var bool orb_done = false

if ny_start
    orb_h := high
    orb_l := low
    orb_cnt := 1
    orb_done := false
else if in_ny and not orb_done
    if orb_cnt < bars_needed
        orb_h := math.max(orb_h, high)
        orb_l := math.min(orb_l, low)
        orb_cnt += 1
    else
        orb_done := true

orb_status = orb_status_for(orb_h, orb_l)

// LONDON ORB
in_london = not na(time(timeframe.period, i_london_session, "America/New_York"))
london_start = in_london and not in_london[1]

var float london_orb_h = na
var float london_orb_l = na
var int london_orb_cnt = 0
var bool london_orb_done = false

if london_start
    london_orb_h := high
    london_orb_l := low
    london_orb_cnt := 1
    london_orb_done := false
else if in_london and not london_orb_done
    if london_orb_cnt < bars_needed
        london_orb_h := math.max(london_orb_h, high)
        london_orb_l := math.min(london_orb_l, low)
        london_orb_cnt += 1
    else
        london_orb_done := true

london_orb_status = orb_status_for(london_orb_h, london_orb_l)

// MARKET CONDITION (declare variable first)
var string market_cond = "RANGE_BOUND"

atr14 = ta.atr(14)
range_ratio = atr14 > 0 ? (high - low) / atr14 : 1.0

if rel_vol < 0.40
    market_cond := "DEAD"
else if range_ratio < 0.40 or rel_vol < 0.60
    market_cond := "CHOPPY"
else if trend_dir != "SIDEWAYS" and rel_vol >= 0.80
    market_cond := "TRENDING"
else
    market_cond := "RANGE_BOUND"

// STRAT CLASSIFICATION (declare variables first)
var string cur_type = "unknown"
var string prev_type = "unknown"
var string t2b_type = "unknown"
var string strat_seq = "no_sequence"
var string strat_dir_ctx = na
var string strat_trigger_ctx = na

cur_type := classify_bar(high, low, high[1], low[1])
prev_type := classify_bar(high[1], low[1], high[2], low[2])
t2b_type := classify_bar(high[2], low[2], high[3], low[3])

if cur_type == "two_up" and prev_type == "inside_bar" and t2b_type == "two_up"
    strat_seq := "strat_212"
    strat_dir_ctx := "LONG"
    strat_trigger_ctx := "continuation"
else if cur_type == "two_down" and prev_type == "inside_bar" and t2b_type == "two_down"
    strat_seq := "strat_212"
    strat_dir_ctx := "SHORT"
    strat_trigger_ctx := "continuation"
else if cur_type == "two_up" and prev_type == "two_down" and t2b_type == "inside_bar"
    strat_seq := "strat_122"
    strat_dir_ctx := "LONG"
    strat_trigger_ctx := "reversal"
else if cur_type == "two_down" and prev_type == "two_up" and t2b_type == "inside_bar"
    strat_seq := "strat_122"
    strat_dir_ctx := "SHORT"
    strat_trigger_ctx := "reversal"
else if (cur_type == "two_up" or cur_type == "two_down") and prev_type == "inside_bar"
    strat_seq := "strat_inside_break"
    strat_dir_ctx := cur_type == "two_up" ? "LONG" : "SHORT"
    strat_trigger_ctx := "breakout"
else if (cur_type == "two_up" or cur_type == "two_down") and prev_type == "outside_bar"
    strat_seq := "strat_outside_continuation"
    strat_dir_ctx := cur_type == "two_up" ? "LONG" : "SHORT"
    strat_trigger_ctx := "outside_bar_followthrough"
else
    strat_seq := "no_sequence"
    strat_dir_ctx := na
    strat_trigger_ctx := na

// PRICE VS LEVELS (declare variables first)
var string price_vs_pdh = "unknown"
var string price_vs_pdl = "unknown"

if na(pd_high)
    price_vs_pdh := "unknown"
else if close > pd_high
    price_vs_pdh := "above"
else if close < pd_high
    price_vs_pdh := "below"
else
    price_vs_pdh := "at"

if na(pd_low)
    price_vs_pdl := "unknown"
else if close > pd_low
    price_vs_pdl := "above"
else if close < pd_low
    price_vs_pdl := "below"
else
    price_vs_pdl := "at"

// BUILD JSON
msg = "{" + '"ticker":"' + syminfo.ticker + '",' + '"timestamp":' + str.tostring(time) + ',' + '"open":' + str.tostring(open, "#.####") + ',' + '"high":' + str.tostring(high, "#.####") + ',' + '"low":' + str.tostring(low, "#.####") + ',' + '"close":' + str.tostring(close, "#.####") + ',' + '"volume":' + str.tostring(volume) + ',' + '"timeframe":"' + timeframe.period + '",' + '"avg_volume":' + str.tostring(math.round(avg_vol)) + ',' + '"vwap":' + f2j(vwap_val, "#.####") + ',' + '"orb_high":' + f2j(orb_h, "#.##") + ',' + '"orb_low":' + f2j(orb_l, "#.##") + ',' + '"orb_status":"' + orb_status + '",' + '"london_orb_high":' + f2j(london_orb_h, "#.##") + ',' + '"london_orb_low":' + f2j(london_orb_l, "#.##") + ',' + '"london_orb_status":' + (na(london_orb_h) ? "null" : '"' + london_orb_status + '"') + ',' + '"market_condition":"' + market_cond + '",' + '"trend_direction":"' + trend_dir + '",' + '"trend_strength":"' + trend_str + '",' + '"previous_day_high":' + f2j(pd_high, "#.##") + ',' + '"previous_day_low":' + f2j(pd_low, "#.##") + ',' + '"previous_day_close":' + f2j(pd_close, "#.##") + ',' + '"price_vs_pdh":"' + price_vs_pdh + '",' + '"price_vs_pdl":"' + price_vs_pdl + '",' + '"previous_bar_high":' + f2j(high[1], "#.####") + ',' + '"previous_bar_low":' + f2j(low[1], "#.####") + ',' + '"two_bars_back_high":' + f2j(high[2], "#.####") + ',' + '"two_bars_back_low":' + f2j(low[2], "#.####") + ',' + '"current_bar_type":"' + cur_type + '",' + '"previous_bar_type":"' + prev_type + '",' + '"two_bars_back_type":"' + t2b_type + '",' + '"strat_sequence":' + s2j(strat_seq == "no_sequence" ? na : strat_seq) + ',' + '"strat_trigger":' + s2j(strat_trigger_ctx) + ',' + '"strat_direction":' + s2j(strat_dir_ctx) + ',' + '"gex_flip":' + f2j(i_gex_flip, "#.##") + ',' + '"call_wall":' + f2j(i_call_wall, "#.##") + ',' + '"put_wall":' + f2j(i_put_wall, "#.##") + ',' + '"hvl":' + f2j(i_hvl, "#.##") + ',' + '"max_pain":' + f2j(i_max_pain, "#.##") + ',' + '"mid_upper":' + f2j(i_mid_upper, "#.##") + ',' + '"mid_lower":' + f2j(i_mid_lower, "#.##") + ',' + '"vol_trigger_up":' + f2j(i_vol_trigger_up, "#.##") + ',' + '"vol_trigger_down":' + f2j(i_vol_trigger_down, "#.##") + ',' + '"gex_regime":' + s2j(i_gex_regime) + ',' + '"delta_bias":' + s2j(i_delta_bias) + ',' + '"signa_grade":' + s2j(i_signa_grade) + ',' + '"signa_score":' + f2j(i_signa_score, "#.##") + ',' + '"signa_daily_direction":' + s2j(i_signa_daily_direction) + ',' + '"signa_weekly_direction":' + s2j(i_signa_weekly_direction) + ',' + '"supply_top":' + f2j(i_supply_top, "#.##") + ',' + '"supply_bottom":' + f2j(i_supply_bottom, "#.##") + ',' + '"supply_wavg":' + f2j(i_supply_wavg, "#.##") + ',' + '"demand_top":' + f2j(i_demand_top, "#.##") + ',' + '"demand_bottom":' + f2j(i_demand_bottom, "#.##") + ',' + '"demand_wavg":' + f2j(i_demand_wavg, "#.##") + "}"

// FIRE ALERT
if i_alert_on and barstate.isconfirmed
    alert(msg, alert.freq_once_per_bar_close)

// CHARTS
plot(ema_fast, "EMA Fast", color=color.new(color.aqua, 30))
plot(ema_slow, "EMA Slow", color=color.new(color.orange, 30))
plot(vwap_val, "VWAP", color=color.new(color.yellow, 20))

orb_h_plot = in_ny or in_ny[1] ? orb_h : na
orb_l_plot = in_ny or in_ny[1] ? orb_l : na
plot(orb_h_plot, "NY ORB High", color=color.new(color.lime, 40), style=plot.style_stepline)
plot(orb_l_plot, "NY ORB Low", color=color.new(color.red, 40), style=plot.style_stepline)

l_orb_h_plot = in_london or in_london[1] ? london_orb_h : na
l_orb_l_plot = in_london or in_london[1] ? london_orb_l : na
plot(l_orb_h_plot, "London ORB High", color=color.new(color.teal, 50), style=plot.style_stepline)
plot(l_orb_l_plot, "London ORB Low", color=color.new(color.orange, 50), style=plot.style_stepline)