//@version=6
indicator("RiskSentinel - Full Context", overlay=true)

// INPUTS
i_orb_min = input.int(15, "ORB Window (min)", minval=5, maxval=60, step=5, group="Opening Range")
i_ny_session = input.session("0930-1200", "NY Session (ET)", group="Opening Range")
i_london_session = input.session("0300-0830", "London Session (ET)", group="Opening Range")
i_ema_fast = input.int(9, "Fast EMA", minval=2, group="Trend")
i_ema_slow = input.int(21, "Slow EMA", minval=5, group="Trend")
i_ema_mid = input.int(55, "Mid EMA", minval=20, group="Trend")
i_ema_long = input.int(200, "Long EMA", minval=50, group="Trend")
i_vol_len = input.int(20, "Volume MA", minval=5, group="Volume")
i_alert_on = input.bool(true, "Fire alert on every confirmed bar close", group="Alert")

// Manual context inputs for gates. Keep blank/na when unavailable; webhook treats missing data as neutral.
i_gex_flip = input.float(na, "GEX Flip", group="GEX / Gamma")
i_call_wall = input.float(na, "Call Wall", group="GEX / Gamma")
i_put_wall = input.float(na, "Put Wall", group="GEX / Gamma")
i_hvl = input.float(na, "HVL", group="GEX / Gamma")
i_max_pain = input.float(na, "Max Pain", group="GEX / Gamma")
i_mid_upper = input.float(na, "Mid Upper", group="GEX / Gamma")
i_mid_lower = input.float(na, "Mid Lower", group="GEX / Gamma")
i_vol_trigger_up = input.float(na, "Vol Trigger Up", group="GEX / Gamma")
i_vol_trigger_down = input.float(na, "Vol Trigger Down", group="GEX / Gamma")
i_gex_regime = input.string("", "GEX Regime", group="GEX / Gamma")
i_delta_bias = input.string("", "Delta Bias", group="GEX / Gamma")

i_signa_grade = input.string("", "Signa Grade", group="Signa")
i_signa_score = input.float(na, "Signa Score", group="Signa")
i_signa_daily_direction = input.string("", "Signa Daily Direction", group="Signa")
i_signa_weekly_direction = input.string("", "Signa Weekly Direction", group="Signa")

i_supply_top = input.float(na, "Supply Zone Top", group="Supply / Demand")
i_supply_bottom = input.float(na, "Supply Zone Bottom", group="Supply / Demand")
i_supply_wavg = input.float(na, "Supply Zone WAVG", group="Supply / Demand")
i_demand_top = input.float(na, "Demand Zone Top", group="Supply / Demand")
i_demand_bottom = input.float(na, "Demand Zone Bottom", group="Supply / Demand")
i_demand_wavg = input.float(na, "Demand Zone WAVG", group="Supply / Demand")

// HELPERS
f2j(v, fmt) => na(v) ? "null" : str.tostring(v, fmt)
s2j(v) => na(v) or v == "" ? "null" : "\"" + v + "\""

classify_bar(h, l, ph, pl) =>
    if na(ph) or na(pl)
        "unknown"
    else
        bh = h > ph
        bl = l < pl
        if bh and bl
            "outside_bar"
        else if not bh and not bl
            "inside_bar"
        else if bh
            "two_up"
        else
            "two_down"

direction_from_bar(bt, o, c) =>
    if bt == "two_up"
        "UP"
    else if bt == "two_down"
        "DOWN"
    else if bt == "outside_bar"
        c >= o ? "UP" : "DOWN"
    else if bt == "inside_bar"
        "NEUTRAL"
    else
        "UNKNOWN"

orb_status_for(orb_high, orb_low) =>
    if na(orb_high) or na(orb_low)
        "undefined"
    else if close > orb_high and close[1] <= orb_high
        "reclaimed_high"
    else if close < orb_low and close[1] >= orb_low
        "reclaimed_low"
    else if close[1] > orb_high and close <= orb_high
        "rejected_high"
    else if close[1] < orb_low and close >= orb_low
        "rejected_low"
    else if close > orb_high
        "above"
    else if close < orb_low
        "below"
    else
        "inside"

// CORE CALCULATIONS
ema_fast = ta.ema(close, i_ema_fast)
ema_slow = ta.ema(close, i_ema_slow)
ema_mid  = ta.ema(close, i_ema_mid)
ema_long = ta.ema(close, i_ema_long)
vwap_val = ta.vwap(hlc3)
avg_vol = ta.sma(volume, i_vol_len)
rel_vol = avg_vol > 0 ? volume / avg_vol : 1.0
vwap_reclaimed = ta.crossover(close, vwap_val)

[pd_high, pd_low, pd_close] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
[pw_high, pw_low] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)

// HTF / FTFC CONTEXT
[d_o, d_h, d_l, d_c, d_ph, d_pl] = request.security(syminfo.tickerid, "D", [open, high, low, close, high[1], low[1]], lookahead=barmerge.lookahead_on)
[h4_o, h4_h, h4_l, h4_c, h4_ph, h4_pl] = request.security(syminfo.tickerid, "240", [open, high, low, close, high[1], low[1]], lookahead=barmerge.lookahead_on)
[h1_o, h1_h, h1_l, h1_c, h1_ph, h1_pl] = request.security(syminfo.tickerid, "60", [open, high, low, close, high[1], low[1]], lookahead=barmerge.lookahead_on)

daily_bar_type = classify_bar(d_h, d_l, d_ph, d_pl)
daily_direction = direction_from_bar(daily_bar_type, d_o, d_c)
four_hour_bar_type = classify_bar(h4_h, h4_l, h4_ph, h4_pl)
four_hour_direction = direction_from_bar(four_hour_bar_type, h4_o, h4_c)
one_hour_bar_type = classify_bar(h1_h, h1_l, h1_ph, h1_pl)
one_hour_direction = direction_from_bar(one_hour_bar_type, h1_o, h1_c)

daily_up = daily_direction == "UP" ? 1 : 0
daily_down = daily_direction == "DOWN" ? 1 : 0
four_hour_up = four_hour_direction == "UP" ? 1 : 0
four_hour_down = four_hour_direction == "DOWN" ? 1 : 0
one_hour_up = one_hour_direction == "UP" ? 1 : 0
one_hour_down = one_hour_direction == "DOWN" ? 1 : 0
ftfc_up_count = daily_up + four_hour_up + one_hour_up
ftfc_down_count = daily_down + four_hour_down + one_hour_down
ftfc_direction = ftfc_up_count == 3 ? "UP" : ftfc_down_count == 3 ? "DOWN" : (ftfc_up_count > 0 and ftfc_down_count > 0 ? "MIXED" : "NEUTRAL")
ftfc_aligned = ftfc_direction == "UP" or ftfc_direction == "DOWN"

// HOD / LOD — highest high and lowest low since session open
in_any_session = not na(time(timeframe.period, i_ny_session, "America/New_York")) or not na(time(timeframe.period, i_london_session, "America/New_York"))
day_change = ta.change(time("D")) > 0
var float hod = na
var float lod = na
if day_change
    hod := high
    lod := low
else
    hod := math.max(nz(hod, high), high)
    lod := math.min(nz(lod, low), low)

// TREND (declare variables first)
var string trend_dir = "SIDEWAYS"
var string trend_str = "WEAK"

diff_pct = math.abs(ema_fast - ema_slow) / ema_slow * 100
if ema_fast > ema_slow and diff_pct > 0.15
    trend_dir := "UP"
else if ema_fast < ema_slow and diff_pct > 0.15
    trend_dir := "DOWN"
else
    trend_dir := "SIDEWAYS"

if diff_pct > 0.40
    trend_str := "STRONG"
else if diff_pct > 0.15
    trend_str := "MODERATE"
else
    trend_str := "WEAK"

// NY ORB
bars_needed = math.max(1, math.round(i_orb_min * 60 / timeframe.in_seconds()))
in_ny = not na(time(timeframe.period, i_ny_session, "America/New_York"))
ny_start = in_ny and not in_ny[1]

var float orb_h = na
var float orb_l = na
var int orb_cnt = 0
var bool orb_done = false

if ny_start
    orb_h := high
    orb_l := low
    orb_cnt := 1
    orb_done := false
else if in_ny and not orb_done
    if orb_cnt < bars_needed
        orb_h := math.max(orb_h, high)
        orb_l := math.min(orb_l, low)
        orb_cnt += 1
    else
        orb_done := true

orb_status = orb_status_for(orb_h, orb_l)

// LONDON ORB
in_london = not na(time(timeframe.period, i_london_session, "America/New_York"))
london_start = in_london and not in_london[1]

var float london_orb_h = na
var float london_orb_l = na
var int london_orb_cnt = 0
var bool london_orb_done = false

if london_start
    london_orb_h := high
    london_orb_l := low
    london_orb_cnt := 1
    london_orb_done := false
else if in_london and not london_orb_done
    if london_orb_cnt < bars_needed
        london_orb_h := math.max(london_orb_h, high)
        london_orb_l := math.min(london_orb_l, low)
        london_orb_cnt += 1
    else
        london_orb_done := true

london_orb_status = orb_status_for(london_orb_h, london_orb_l)

// MARKET CONDITION (declare variable first)
var string market_cond = "RANGE_BOUND"

atr14 = ta.atr(14)
range_ratio = atr14 > 0 ? (high - low) / atr14 : 1.0

if rel_vol < 0.40
    market_cond := "DEAD"
else if range_ratio < 0.40 or rel_vol < 0.60
    market_cond := "CHOPPY"
else if trend_dir != "SIDEWAYS" and rel_vol >= 0.80
    market_cond := "TRENDING"
else
    market_cond := "RANGE_BOUND"

// STRAT CLASSIFICATION (declare variables first)
var string cur_type = "unknown"
var string prev_type = "unknown"
var string t2b_type = "unknown"
var string strat_seq = "no_sequence"
var string strat_dir_ctx = na
var string strat_trigger_ctx = na

cur_type := classify_bar(high, low, high[1], low[1])
prev_type := classify_bar(high[1], low[1], high[2], low[2])
t2b_type := classify_bar(high[2], low[2], high[3], low[3])

if cur_type == "two_up" and prev_type == "inside_bar" and t2b_type == "two_up"
    strat_seq := "strat_212"
    strat_dir_ctx := "LONG"
    strat_trigger_ctx := "continuation"
else if cur_type == "two_down" and prev_type == "inside_bar" and t2b_type == "two_down"
    strat_seq := "strat_212"
    strat_dir_ctx := "SHORT"
    strat_trigger_ctx := "continuation"
else if cur_type == "two_up" and prev_type == "two_down" and t2b_type == "inside_bar"
    strat_seq := "strat_122"
    strat_dir_ctx := "LONG"
    strat_trigger_ctx := "reversal"
else if cur_type == "two_down" and prev_type == "two_up" and t2b_type == "inside_bar"
    strat_seq := "strat_122"
    strat_dir_ctx := "SHORT"
    strat_trigger_ctx := "reversal"
else if (cur_type == "two_up" or cur_type == "two_down") and prev_type == "inside_bar"
    strat_seq := "strat_inside_break"
    strat_dir_ctx := cur_type == "two_up" ? "LONG" : "SHORT"
    strat_trigger_ctx := "breakout"
else if (cur_type == "two_up" or cur_type == "two_down") and prev_type == "outside_bar"
    strat_seq := "strat_outside_continuation"
    strat_dir_ctx := cur_type == "two_up" ? "LONG" : "SHORT"
    strat_trigger_ctx := "outside_bar_followthrough"
else
    strat_seq := "no_sequence"
    strat_dir_ctx := na
    strat_trigger_ctx := na

// PRICE VS LEVELS (declare variables first)
var string price_vs_pdh = "unknown"
var string price_vs_pdl = "unknown"

if na(pd_high)
    price_vs_pdh := "unknown"
else if close > pd_high
    price_vs_pdh := "above"
else if close < pd_high
    price_vs_pdh := "below"
else
    price_vs_pdh := "at"

if na(pd_low)
    price_vs_pdl := "unknown"
else if close > pd_low
    price_vs_pdl := "above"
else if close < pd_low
    price_vs_pdl := "below"
else
    price_vs_pdl := "at"

// EMA FLAGS
ema_9_above_21 = ema_fast > ema_slow

// ADVISORY BRACKET
// Pine sends candidate bracket coordinates; backend still validates the setup,
// strategy match, R:R, and minimum target distance before any paper fill.
f_rr(dir, e, s, t) =>
    risk = dir == "LONG" ? e - s : s - e
    reward = dir == "LONG" ? t - e : e - t
    risk > 0 ? reward / risk : na

f_min_target(dir, e, raw_t, min_pts) =>
    min_pts <= 0 ? raw_t : dir == "LONG" ? math.max(raw_t, e + min_pts) : math.min(raw_t, e - min_pts)

root_ticker = str.upper(syminfo.root)
min_target_pts = root_ticker == "MES" or str.contains(syminfo.ticker, "MES") ? 15.0 : root_ticker == "MNQ" or str.contains(syminfo.ticker, "MNQ") ? 15.0 : 0.0
max_stop_ticks = root_ticker == "MES" or str.contains(syminfo.ticker, "MES") ? 40.0 : root_ticker == "MNQ" or str.contains(syminfo.ticker, "MNQ") ? 80.0 : 40.0

string signal_strategy = na
string signal_direction = na
float signal_entry = na
float signal_stop = na
float signal_target = na
float signal_rr = na
float raw_target = na

if not na(orb_h) and not na(orb_l) and orb_status == "reclaimed_high" and trend_dir == "UP" and close > vwap_val and rel_vol >= 0.7
    signal_strategy := "strat_4hr_retrigger"
    signal_direction := "LONG"
    signal_entry := orb_h + syminfo.mintick
    signal_stop := math.max(orb_h - syminfo.mintick * 8, signal_entry - syminfo.mintick * max_stop_ticks)
    raw_target := signal_entry + (signal_entry - signal_stop) * 2.0
else if not na(orb_h) and not na(orb_l) and orb_status == "above" and trend_dir == "UP" and close > vwap_val
    signal_strategy := "orb_breakout"
    signal_direction := "LONG"
    signal_entry := orb_h + syminfo.mintick * 2
    signal_stop := math.max(orb_h - syminfo.mintick * 8, signal_entry - syminfo.mintick * max_stop_ticks)
    raw_target := signal_entry + (signal_entry - signal_stop) * 2.2
else if not na(orb_h) and not na(orb_l) and orb_status == "below" and trend_dir == "DOWN" and close < vwap_val
    signal_strategy := "orb_breakout"
    signal_direction := "SHORT"
    signal_entry := orb_l - syminfo.mintick * 2
    signal_stop := math.min(orb_l + syminfo.mintick * 8, signal_entry + syminfo.mintick * max_stop_ticks)
    raw_target := signal_entry - (signal_stop - signal_entry) * 2.2
else if not na(orb_h) and not na(orb_l) and orb_status == "reclaimed_high" and trend_dir == "UP" and close > vwap_val
    signal_strategy := "orb_reclaim"
    signal_direction := "LONG"
    signal_entry := orb_h + syminfo.mintick * 2
    signal_stop := math.max(orb_l - syminfo.mintick * 4, signal_entry - syminfo.mintick * max_stop_ticks)
    raw_target := signal_entry + (signal_entry - signal_stop) * 2.5
else if not na(orb_h) and not na(orb_l) and orb_status == "rejected_high"
    signal_strategy := "orb_rejection"
    signal_direction := "SHORT"
    signal_entry := orb_h - syminfo.mintick * 2
    signal_stop := math.min(orb_h + syminfo.mintick * 6, signal_entry + syminfo.mintick * max_stop_ticks)
    raw_target := signal_entry - (signal_stop - signal_entry) * 2.5
else if vwap_reclaimed and trend_dir == "UP" and close > vwap_val
    signal_strategy := "vwap_reclaim"
    signal_direction := "LONG"
    signal_entry := vwap_val + syminfo.mintick * 2
    signal_stop := vwap_val - syminfo.mintick * 28
    raw_target := signal_entry + (signal_entry - signal_stop) * 3.0
else if trend_dir == "DOWN" and close < vwap_val
    signal_strategy := "vwap_hold"
    signal_direction := "SHORT"
    signal_entry := vwap_val - syminfo.mintick * 2
    signal_stop := vwap_val + syminfo.mintick * 28
    raw_target := signal_entry - (signal_stop - signal_entry) * 3.0
else if trend_dir == "UP" and close > vwap_val and close - vwap_val <= syminfo.mintick * 6
    signal_strategy := "continuation_pullback"
    signal_direction := "LONG"
    signal_entry := close
    signal_stop := vwap_val - syminfo.mintick * 8
    raw_target := signal_entry + (signal_entry - signal_stop) * 2.0
else if trend_dir == "DOWN" and close < vwap_val and vwap_val - close <= syminfo.mintick * 6
    signal_strategy := "continuation_pullback"
    signal_direction := "SHORT"
    signal_entry := close
    signal_stop := vwap_val + syminfo.mintick * 8
    raw_target := signal_entry - (signal_stop - signal_entry) * 2.0

if not na(signal_entry) and not na(signal_stop) and not na(raw_target)
    signal_target := f_min_target(signal_direction, signal_entry, raw_target, min_target_pts)
    signal_rr := f_rr(signal_direction, signal_entry, signal_stop, signal_target)

// BUILD JSON
string msg = "{"
msg := msg + "\"ticker\":" + "\"" + syminfo.ticker + "\"" + ","
msg := msg + "\"timestamp\":" + str.tostring(time) + ","
msg := msg + "\"open\":" + str.tostring(open, "#.####") + ","
msg := msg + "\"high\":" + str.tostring(high, "#.####") + ","
msg := msg + "\"low\":" + str.tostring(low, "#.####") + ","
msg := msg + "\"close\":" + str.tostring(close, "#.####") + ","
msg := msg + "\"volume\":" + str.tostring(volume) + ","
msg := msg + "\"timeframe\":" + "\"" + timeframe.period + "\"" + ","
msg := msg + "\"avg_volume\":" + str.tostring(math.round(avg_vol)) + ","
msg := msg + "\"vwap\":" + f2j(vwap_val, "#.####") + ","
msg := msg + "\"vwap_reclaimed\":" + str.tostring(vwap_reclaimed) + ","
msg := msg + "\"orb_high\":" + f2j(orb_h, "#.##") + ","
msg := msg + "\"orb_low\":" + f2j(orb_l, "#.##") + ","
msg := msg + "\"orb_status\":" + "\"" + orb_status + "\"" + ","
msg := msg + "\"london_orb_high\":" + f2j(london_orb_h, "#.##") + ","
msg := msg + "\"london_orb_low\":" + f2j(london_orb_l, "#.##") + ","
msg := msg + "\"london_orb_status\":" + (na(london_orb_h) ? "null" : "\"" + london_orb_status + "\"") + ","
msg := msg + "\"market_condition\":" + "\"" + market_cond + "\"" + ","
msg := msg + "\"trend_direction\":" + "\"" + trend_dir + "\"" + ","
msg := msg + "\"trend_strength\":" + "\"" + trend_str + "\"" + ","
msg := msg + "\"previous_day_high\":" + f2j(pd_high, "#.##") + ","
msg := msg + "\"previous_day_low\":" + f2j(pd_low, "#.##") + ","
msg := msg + "\"previous_day_close\":" + f2j(pd_close, "#.##") + ","
msg := msg + "\"price_vs_pdh\":" + "\"" + price_vs_pdh + "\"" + ","
msg := msg + "\"price_vs_pdl\":" + "\"" + price_vs_pdl + "\"" + ","
msg := msg + "\"previous_bar_high\":" + f2j(high[1], "#.####") + ","
msg := msg + "\"previous_bar_low\":" + f2j(low[1], "#.####") + ","
msg := msg + "\"two_bars_back_high\":" + f2j(high[2], "#.####") + ","
msg := msg + "\"two_bars_back_low\":" + f2j(low[2], "#.####") + ","
msg := msg + "\"current_bar_type\":" + "\"" + cur_type + "\"" + ","
msg := msg + "\"previous_bar_type\":" + "\"" + prev_type + "\"" + ","
msg := msg + "\"two_bars_back_type\":" + "\"" + t2b_type + "\"" + ","
msg := msg + "\"strat_sequence\":" + s2j(strat_seq == "no_sequence" ? na : strat_seq) + ","
msg := msg + "\"strat_trigger\":" + s2j(strat_trigger_ctx) + ","
msg := msg + "\"strat_direction\":" + s2j(strat_dir_ctx) + ","
msg := msg + "\"signal_strategy\":" + s2j(signal_strategy) + ","
msg := msg + "\"signal_direction\":" + s2j(signal_direction) + ","
msg := msg + "\"entry\":" + f2j(signal_entry, "#.####") + ","
msg := msg + "\"stop\":" + f2j(signal_stop, "#.####") + ","
msg := msg + "\"target\":" + f2j(signal_target, "#.####") + ","
msg := msg + "\"rr_ratio\":" + f2j(signal_rr, "#.####") + ","
msg := msg + "\"gex_flip\":" + f2j(i_gex_flip, "#.##") + ","
msg := msg + "\"call_wall\":" + f2j(i_call_wall, "#.##") + ","
msg := msg + "\"put_wall\":" + f2j(i_put_wall, "#.##") + ","
msg := msg + "\"hvl\":" + f2j(i_hvl, "#.##") + ","
msg := msg + "\"max_pain\":" + f2j(i_max_pain, "#.##") + ","
msg := msg + "\"mid_upper\":" + f2j(i_mid_upper, "#.##") + ","
msg := msg + "\"mid_lower\":" + f2j(i_mid_lower, "#.##") + ","
msg := msg + "\"vol_trigger_up\":" + f2j(i_vol_trigger_up, "#.##") + ","
msg := msg + "\"vol_trigger_down\":" + f2j(i_vol_trigger_down, "#.##") + ","
msg := msg + "\"gex_regime\":" + s2j(i_gex_regime) + ","
msg := msg + "\"delta_bias\":" + s2j(i_delta_bias) + ","
msg := msg + "\"signa_grade\":" + s2j(i_signa_grade) + ","
msg := msg + "\"signa_score\":" + f2j(i_signa_score, "#.##") + ","
msg := msg + "\"signa_daily_direction\":" + s2j(i_signa_daily_direction) + ","
msg := msg + "\"signa_weekly_direction\":" + s2j(i_signa_weekly_direction) + ","
msg := msg + "\"daily_bar_type\":" + s2j(daily_bar_type) + ","
msg := msg + "\"daily_direction\":" + s2j(daily_direction) + ","
msg := msg + "\"four_hour_bar_type\":" + s2j(four_hour_bar_type) + ","
msg := msg + "\"four_hour_direction\":" + s2j(four_hour_direction) + ","
msg := msg + "\"one_hour_bar_type\":" + s2j(one_hour_bar_type) + ","
msg := msg + "\"one_hour_direction\":" + s2j(one_hour_direction) + ","
msg := msg + "\"ftfc_direction\":" + s2j(ftfc_direction) + ","
msg := msg + "\"ftfc_aligned\":" + str.tostring(ftfc_aligned) + ","
msg := msg + "\"supply_top\":" + f2j(i_supply_top, "#.##") + ","
msg := msg + "\"supply_bottom\":" + f2j(i_supply_bottom, "#.##") + ","
msg := msg + "\"supply_wavg\":" + f2j(i_supply_wavg, "#.##") + ","
msg := msg + "\"demand_top\":" + f2j(i_demand_top, "#.##") + ","
msg := msg + "\"demand_bottom\":" + f2j(i_demand_bottom, "#.##") + ","
msg := msg + "\"demand_wavg\":" + f2j(i_demand_wavg, "#.##") + ","
msg := msg + "\"hod\":" + f2j(hod, "#.##") + ","
msg := msg + "\"lod\":" + f2j(lod, "#.##") + ","
msg := msg + "\"prev_week_high\":" + f2j(pw_high, "#.##") + ","
msg := msg + "\"prev_week_low\":" + f2j(pw_low, "#.##") + ","
msg := msg + "\"ema_9\":" + f2j(ema_fast, "#.####") + ","
msg := msg + "\"ema_21\":" + f2j(ema_slow, "#.####") + ","
msg := msg + "\"ema_55\":" + f2j(ema_mid, "#.####") + ","
msg := msg + "\"ema_200\":" + f2j(ema_long, "#.####") + ","
msg := msg + "\"ema_9_above_21\":" + str.tostring(ema_9_above_21)
msg := msg + "}"

// FIRE ALERT
if i_alert_on and barstate.isconfirmed
    alert(msg, alert.freq_once_per_bar_close)

// CHARTS
plot(ema_fast, "EMA 9",   color=color.new(color.aqua, 30))
plot(ema_slow, "EMA 21",  color=color.new(color.orange, 30))
plot(ema_mid,  "EMA 55",  color=color.new(color.purple, 40))
plot(ema_long, "EMA 200", color=color.new(color.gray, 40))
plot(vwap_val, "VWAP",    color=color.new(color.yellow, 20))
plot(hod, "HOD", color=color.new(color.lime, 60), style=plot.style_stepline, linewidth=1)
plot(lod, "LOD", color=color.new(color.red,  60), style=plot.style_stepline, linewidth=1)

orb_h_plot = in_ny or in_ny[1] ? orb_h : na
orb_l_plot = in_ny or in_ny[1] ? orb_l : na
plot(orb_h_plot, "NY ORB High", color=color.new(color.lime, 40), style=plot.style_stepline)
plot(orb_l_plot, "NY ORB Low", color=color.new(color.red, 40), style=plot.style_stepline)

l_orb_h_plot = in_london or in_london[1] ? london_orb_h : na
l_orb_l_plot = in_london or in_london[1] ? london_orb_l : na
plot(l_orb_h_plot, "London ORB High", color=color.new(color.teal, 50), style=plot.style_stepline)
plot(l_orb_l_plot, "London ORB Low", color=color.new(color.orange, 50), style=plot.style_stepline)