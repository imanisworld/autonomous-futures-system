//@version=5
// RiskSentinel — BOS, MSS, Supply/Demand, FTFC additions
// Add this code to your existing webhook Pine Script.
// Copy each section and paste it before your alert() call.
// Then add the JSON fields shown at the bottom into your alert string.

// ── SECTION 1: BOS / MSS Detection ──────────────────────────────────────────
bos_swing_len = 5

var float last_sh     = na
var float last_sl     = na
var string prior_bias = "neutral"

sh = ta.pivothigh(high, bos_swing_len, bos_swing_len)
sl = ta.pivotlow(low,  bos_swing_len, bos_swing_len)

if not na(sh)
    last_sh := sh
if not na(sl)
    last_sl := sl

bos_bull_raw = not na(last_sh) and close > last_sh and close[1] <= last_sh
bos_bear_raw = not na(last_sl) and close < last_sl and close[1] >= last_sl

mss_bull = bos_bull_raw and prior_bias == "bearish"
mss_bear = bos_bear_raw and prior_bias == "bullish"
bos_bull = bos_bull_raw and not mss_bull
bos_bear = bos_bear_raw and not mss_bear

if bos_bull_raw
    prior_bias := "bullish"
if bos_bear_raw
    prior_bias := "bearish"

market_structure_str = mss_bull ? "bullish_mss"  :
                       mss_bear ? "bearish_mss"  :
                       bos_bull ? "bullish_bos"  :
                       bos_bear ? "bearish_bos"  : "none"

bos_dir_str = bos_bull ? "bullish" : bos_bear ? "bearish" : ""
mss_dir_str = mss_bull ? "bullish" : mss_bear ? "bearish" : ""

// ── SECTION 2: FTFC — Full Time Frame Continuity ─────────────────────────────
[o5,  c5 ] = request.security(syminfo.tickerid, "5",   [open, close], lookahead=barmerge.lookahead_on)
[o15, c15] = request.security(syminfo.tickerid, "15",  [open, close], lookahead=barmerge.lookahead_on)
[o60, c60] = request.security(syminfo.tickerid, "60",  [open, close], lookahead=barmerge.lookahead_on)
[o240,c240]= request.security(syminfo.tickerid, "240", [open, close], lookahead=barmerge.lookahead_on)
[oD,  cD ] = request.security(syminfo.tickerid, "D",   [open, close], lookahead=barmerge.lookahead_on)

bull_tfs = (c5   > o5   ? 1 : 0) +
           (c15  > o15  ? 1 : 0) +
           (c60  > o60  ? 1 : 0) +
           (c240 > o240 ? 1 : 0) +
           (cD   > oD   ? 1 : 0)

ftfc_dir_str  = bull_tfs >= 4 ? "UP" : bull_tfs <= 1 ? "DOWN" : "MIXED"
ftfc_ok       = bull_tfs == 5 or bull_tfs == 0

// ── SECTION 3: Supply & Demand Zones ─────────────────────────────────────────
sd_len = 10
zone_thick = syminfo.mintick * 20

sd_sh = ta.pivothigh(high, sd_len, sd_len)
sd_sl = ta.pivotlow(low,   sd_len, sd_len)

var float sup_top  = na
var float sup_bot  = na
var float dem_top  = na
var float dem_bot  = na
var int   sup_hits = 0
var int   dem_hits = 0

if not na(sd_sh)
    sup_top  := sd_sh + zone_thick
    sup_bot  := sd_sh - zone_thick * 2
    sup_hits := 0

if not na(sd_sl)
    dem_top  := sd_sl + zone_thick * 2
    dem_bot  := sd_sl - zone_thick
    dem_hits := 0

if not na(sup_top) and high >= sup_bot and high <= sup_top
    sup_hits := sup_hits + 1
if not na(dem_top) and low >= dem_bot and low <= dem_top
    dem_hits := dem_hits + 1

sup_state = sup_hits <= 1 ? "fresh" : sup_hits <= 3 ? "tested" : "stale"
dem_state = dem_hits <= 1 ? "fresh" : dem_hits <= 3 ? "tested" : "stale"

in_supply = not na(sup_top) and close >= sup_bot and close <= sup_top
in_demand = not na(dem_top) and close >= dem_bot and close <= dem_top

zone_type_str  = in_supply and in_demand ? "both" : in_supply ? "supply" : in_demand ? "demand" : ""
zone_state_str = in_supply ? sup_state   : in_demand ? dem_state : ""

sup_wavg = not na(sup_top) ? math.avg(sup_top, sup_bot) : float(na)
dem_wavg = not na(dem_top) ? math.avg(dem_top, dem_bot) : float(na)

// ── SECTION 4: Add these fields to your existing alert() JSON string ─────────
// Find your alert string variable (e.g. alertMsg = '{"ticker":...}')
// and add these lines before the closing '}'

bos_json     = ',"market_structure":"' + market_structure_str + '"' +
               ',"bos_direction":'     + (bos_dir_str != "" ? '"' + bos_dir_str + '"' : 'null') +
               ',"mss_direction":'     + (mss_dir_str != "" ? '"' + mss_dir_str + '"' : 'null')

ftfc_json    = ',"ftfc_direction":"'   + ftfc_dir_str + '"' +
               ',"ftfc_aligned":'      + str.tostring(ftfc_ok)

sd_json      = ',"supply_top":'        + (not na(sup_top)   ? str.tostring(math.round(sup_top,  2)) : 'null') +
               ',"supply_bottom":'     + (not na(sup_bot)   ? str.tostring(math.round(sup_bot,  2)) : 'null') +
               ',"supply_wavg":'       + (not na(sup_wavg)  ? str.tostring(math.round(sup_wavg, 2)) : 'null') +
               ',"demand_top":'        + (not na(dem_top)   ? str.tostring(math.round(dem_top,  2)) : 'null') +
               ',"demand_bottom":'     + (not na(dem_bot)   ? str.tostring(math.round(dem_bot,  2)) : 'null') +
               ',"demand_wavg":'       + (not na(dem_wavg)  ? str.tostring(math.round(dem_wavg, 2)) : 'null') +
               ',"zone_type":'         + (zone_type_str  != "" ? '"' + zone_type_str  + '"' : 'null') +
               ',"zone_state":'        + (zone_state_str != "" ? '"' + zone_state_str + '"' : 'null')

// Your final alert call should look like this:
// alert(yourExistingJson + bos_json + ftfc_json + sd_json + '}', alert.freq_once_per_bar_close)
// (remove the existing closing '}' from yourExistingJson before concatenating)
