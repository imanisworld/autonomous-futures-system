// Supply & Demand Zone — Webhook Payload Snippet
// Add these inputs to your existing alert script.
// Update supply_top/bottom and demand_top/bottom whenever LuxAlgo shows new zones.
// The webhook will receive these and gate entries against zone location.
//
// Usage: copy into your main Pine alert script, then include the
// sd_json variable in your alert message JSON payload.

//@version=5

// ── Zone inputs (update when LuxAlgo zones change) ───────────────────────────
var float sd_supply_top    = input.float(defval = na, title = "Supply Zone Top")
var float sd_supply_bottom = input.float(defval = na, title = "Supply Zone Bottom")
var float sd_supply_wavg   = input.float(defval = na, title = "Supply Zone WAVG (from LuxAlgo)")
var float sd_demand_top    = input.float(defval = na, title = "Demand Zone Top")
var float sd_demand_bottom = input.float(defval = na, title = "Demand Zone Bottom")
var float sd_demand_wavg   = input.float(defval = na, title = "Demand Zone WAVG (from LuxAlgo)")

// ── Location flags (computed each bar) ───────────────────────────────────────
_in_supply = not na(sd_supply_bottom) and not na(sd_supply_top) and
             close >= sd_supply_bottom and close <= sd_supply_top

_in_demand = not na(sd_demand_bottom) and not na(sd_demand_top) and
             close >= sd_demand_bottom and close <= sd_demand_top

_above_supply = not na(sd_supply_top) and close > sd_supply_top
_below_demand = not na(sd_demand_bottom) and close < sd_demand_bottom

sd_location = _in_supply   ? "in_supply"    :
              _in_demand    ? "in_demand"    :
              _above_supply ? "above_supply" :
              _below_demand ? "below_demand" : "between_zones"

// ── JSON fragment to embed in your alert message ──────────────────────────────
// Paste the contents of sd_json into your alert message alongside your
// existing fields. Example alert message structure:
//
// {
//   "instrument": "{{ticker}}",
//   "close": {{close}},
//   ... your existing fields ...
//   "supply_top": ' + str.tostring(sd_supply_top, "#.##") + ',
//   "supply_bottom": ' + str.tostring(sd_supply_bottom, "#.##") + ',
//   "supply_wavg": ' + str.tostring(sd_supply_wavg, "#.##") + ',
//   "demand_top": ' + str.tostring(sd_demand_top, "#.##") + ',
//   "demand_bottom": ' + str.tostring(sd_demand_bottom, "#.##") + ',
//   "demand_wavg": ' + str.tostring(sd_demand_wavg, "#.##") + ',
//   "sd_location": "' + sd_location + '"
// }

// ── Optional: visual markers on chart ────────────────────────────────────────
plotshape(_in_supply,  style = shape.triangledown, location = location.abovebar,
          color = color.new(#2157f3, 0), size = size.tiny, title = "In Supply")
plotshape(_in_demand,  style = shape.triangleup,   location = location.belowbar,
          color = color.new(#ff5d00, 0), size = size.tiny, title = "In Demand")
