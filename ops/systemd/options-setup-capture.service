[Unit]
Description=AFS options setup-capture observation-only collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Integrity flag: the 122 collector uses WorkingDirectory=/root/autonomous-futures-system
# (repo checkout, not the integrity-pinned /root/afs-releases/<sha> path). This unit
# follows that pattern for code, but the journal path is ABSOLUTE under
# /root/afs-shared/logs so Friday WATCHING survives a promote and ProtectSystem=strict.
WorkingDirectory=/root/autonomous-futures-system
EnvironmentFile=/root/afs-shared/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/root/autonomous-futures-system/.venv/bin/python -m scripts.options_setup_capture_collect --env-file /root/afs-shared/.env --journal /root/afs-shared/logs/options_setup_capture.jsonl --raw-trade-dir /root/afs-shared/logs/options_setup_capture_source_trades
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/afs-shared/logs

# Observation only: no scanner DB, broker, risk, order, alert, Discord, or ACTIVE state.
# Watcher universe is SPY/QQQ/SPX in code; never OPTIONS_SCANNER_WATCHLIST.
#
# Timer-install prerequisite: a measurable NTP offset must be available via
# `timedatectl timesync-status` (systemd-timesyncd) or `chronyc tracking`.
# Without that, every oneshot run journals DATA_BLOCKED clock_unsynced.
