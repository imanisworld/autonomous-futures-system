# ============================================================
# Local development overrides — Autonomous Futures Paper System
# ============================================================
# Copy this file to .env.local for local runs:
#
#   cp .env.local.example .env.local
#
# .env.local is git-ignored (see .gitignore) and is loaded by
# scripts/dev.sh BEFORE the app reads .env. Because config.settings
# calls load_dotenv(".env") with override=False, any variable already
# exported here wins over the box-oriented values baked into .env.
#
# Use this only for values that differ between the deploy box and a
# local checkout. Keep real secrets out of version control.
# ============================================================

# The live/demo box points LOG_DIR at an absolute deploy path (e.g.
# /app/logs) that does not exist on a local checkout. Keep replay and
# tooling writing to a repo-relative logs/ dir locally.
LOG_DIR=logs

# The box runs PUBLIC_DEMO_MODE=true so only a sanitized read-only
# surface is reachable; everything else 404s. Turn it off locally to
# reach the full dashboard, status APIs, and /webhook/alert.
PUBLIC_DEMO_MODE=false

# The webhook server (scripts/dev.sh web) requires a webhook secret at
# startup, so set one for local runs. Send it via the X-Webhook-Secret
# header when calling /webhook/alert (the legacy ?secret= query param is
# rejected). Use any local-only value here.
WEBHOOK_SECRET=local-dev-secret
