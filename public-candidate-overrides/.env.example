# Public-safe local example.
# Copy to .env and review every value before running.
# Never commit real secrets.

LIVE_TRADING_ENABLED=false
PAPER_MODE=true
BROKER=paper

LOG_LEVEL=INFO
LOG_DIR=logs
HOST=127.0.0.1
PORT=8000
SYSTEM_TZ=America/New_York

RISK_RULES_PATH=risk_rules.yaml
MAX_DATA_STALENESS_SECONDS=300

# Optional local webhook ingestion.
WEBHOOK_SECRET=
ALLOW_SECRET_IN_QUERY=false

# Optional notifications.
DISCORD_NOTIFICATIONS_ENABLED=false
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional read-only data providers.
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io
SIGNA_API_ENABLED=false
SIGNA_API_KEY=
SIGNA_BASE_URL=https://app.getsigna.ai

# Broker-connected demo testing is intentionally unconfigured here.
# Do not add real broker credentials to a public repository.
TRADOVATE_ENV=
TRADOVATE_API_KEY_ID=
TRADOVATE_API_KEY_SECRET=
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_EXPECTED_ACCOUNT_ID=

# Public.com / other optional providers.
PUBLIC_API_ENABLED=false
PUBLIC_API_SECRET_KEY=
PUBLIC_ACCOUNT_ID=
PUBLIC_API_KEY=
PUBLIC_BASE_URL=https://api.public.com
