# ============================================================
# Environment Configuration — Autonomous Futures Paper System
# ============================================================
# Copy this file to .env and review every value before running.
# NEVER commit .env to version control.
# ============================================================
# ─── Trading Mode (CRITICAL) ─────────────────────────────────
# DO NOT change to true in Phase 1. Doing so raises LiveTradingBlockedError.
LIVE_TRADING_ENABLED=false

# Paper mode must always be true in Phase 1
PAPER_MODE=true

# ─── System Settings ─────────────────────────────────────────
LOG_LEVEL=INFO
# Local default: a repo-relative `logs/` dir. Replay and tooling read/write here.
# The live/demo box overrides this to its absolute deploy path (e.g. /app/logs or
# /root/autonomous-futures-system/logs) in its own environment — do NOT bake a
# box-absolute path into this example, or a local `.env` copy will point replay
# and tooling at a path that doesn't exist locally.
LOG_DIR=logs
STARTING_BALANCE=1500

# Execution posture. always_on_shadow evaluates and journals candidates but the
# single execution chokepoint suppresses every broker order.
SCHEDULE_MODE=current

# HTF policy: off | strict | prioritize.
HTF_DIRECTION_MODE=off
# Where daily/4H direction comes from when HTF_DIRECTION_MODE is active:
# payload = TradingView's completed-bar labels (lag intraday turns);
# live = computed server-side from price vs yesterday's range / prior 4h window.
HTF_DIRECTION_SOURCE=payload
# Which timeframe controls when Daily and 4H explicitly disagree.
HTF_CONFLICT_POLICY=four_hour_confirmed

# ─── Live Box Drift Guard (read-only) ────────────────────────
# Set these on the active live/demo box after config freeze and before any
# controlled live validation. Doctor, /status/diagnostics, /status/today, and
# live preflight expose mismatches without mutating git/config/broker state.
EXPECTED_LIVE_REPO_ROOT=/root/autonomous-futures-system
EXPECTED_LIVE_BRANCH=main
EXPECTED_LIVE_COMMIT=
EXPECTED_RISK_RULES_SHA256=
EXPECTED_RELEASE_FINGERPRINT=
EXPECTED_RUNTIME_EVIDENCE_SOURCE=active_box_journal_and_status
EXPECTED_RUNTIME_JOURNAL_DIR=/root/autonomous-futures-system/logs
EXPECTED_RUNTIME_STATUS_PATHS=/status/today,/status/broker-account
RUNTIME_EVIDENCE_SOURCE=active_box_journal_and_status
# Proof-critical runtime overrides are always reported by the guard. If one is
# active it must be pinned to its exact value with EXPECTED_PROOF_<NAME>.
# Pin <unset> to detect an override being introduced during the proof window.
EXPECTED_PROOF_PAPER_MODE=<unset>
EXPECTED_PROOF_LIVE_TRADING_ENABLED=<unset>
EXPECTED_PROOF_BROKER=<unset>
EXPECTED_PROOF_TRADOVATE_ENV=<unset>
EXPECTED_PROOF_STARTING_BALANCE=<unset>
EXPECTED_PROOF_REQUIRE_TRENDING_CONDITION=<unset>
EXPECTED_PROOF_VWAP_ENTRY_MAX_DISTANCE_TICKS=<unset>
EXPECTED_PROOF_MOMENTUM_ENTRY_REANCHOR=<unset>
EXPECTED_PROOF_SCHEDULE_MODE=<unset>
EXPECTED_PROOF_HTF_DIRECTION_MODE=<unset>
EXPECTED_PROOF_PRIMARY_DECISION_TF=<unset>
EXPECTED_PROOF_EXPECTED_TIMEFRAME_MINUTES=<unset>
EXPECTED_PROOF_MAX_CONTRACTS_HARD_CAP=<unset>
EXPECTED_PROOF_ENTRY_SLIPPAGE_TOLERANCE_TICKS=<unset>
EXPECTED_PROOF_ENTRY_SLIPPAGE_TOLERANCE_TICKS_MES=<unset>
EXPECTED_PROOF_ENTRY_SLIPPAGE_TOLERANCE_TICKS_MNQ=<unset>
EXPECTED_PROOF_SIGNA_GATE_ENFORCED=<unset>
EXPECTED_PROOF_LIVE_QUOTE_ENABLED=<unset>
EXPECTED_PROOF_FILL_SLIPPAGE_TICKS=<unset>
EXPECTED_PROOF_FILL_PESSIMISTIC_BOTH_HIT=<unset>
EXPECTED_PROOF_BREAKEVEN_AT_1R=<unset>
EXPECTED_PROOF_RUNNER_SHADOW_ENABLED=<unset>
EXPECTED_PROOF_RUNNER_ACTIVATION_R=<unset>
EXPECTED_PROOF_RUNNER_TRAIL_R=<unset>

# Local default is 127.0.0.1:8000. Deployment platforms may set HOST/PORT.
HOST=127.0.0.1
PORT=8000

# Timezone for session detection (do not change)
SYSTEM_TZ=America/New_York

# ─── Risk Rules ──────────────────────────────────────────────
# Path to risk_rules.yaml (relative to project root)
RISK_RULES_PATH=risk_rules.yaml

# ─── Data Settings ───────────────────────────────────────────
# Maximum age of market state data in seconds (default 300 = 5 min)
MAX_DATA_STALENESS_SECONDS=300

# ─── Polygon.io / Massive (historical futures bars, optional) ─
# Free "Futures Basic" key from massive.com (polygon.io). Read-only
# historical bar backfill/backtest data only. Leave blank to disable.
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io

# ─── TradingView Webhook ─────────────────────────────────────
# Required to start the server. The inbound secret can be supplied three ways,
# in order of preference:
#   1. X-Webhook-Secret request header (most private)
#   2. a "secret" field inside the JSON body (TradingView templates support this)
#   3. ?secret=... URL query param (works, but leaks into access logs — see below)
# Use a unique local value. This is not a broker credential.
WEBHOOK_SECRET=

# Optional additional accepted secrets for zero-downtime TradingView rotation.
# Keep WEBHOOK_SECRET as the primary server secret. Stage the replacement in
# _NEXT, switch TradingView, then promote it and clear _NEXT.
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_WEBHOOK_SECRET_NEXT=

# Allow the secret to travel as a ?secret= URL query param. On by default so
# existing TradingView alerts keep working. Once your alert sends the secret in
# the body (or via a header), set this to false to close the log-leak path.
ALLOW_SECRET_IN_QUERY=true

# ─── Web Exposure / Security ─────────────────────────────────
# Simple site access code. Leave blank to disable (anyone can open the site).
# When set, visitors must enter this exact code once; it is then remembered in a
# cookie. No code = the site can't be opened. Webhook ingestion (/webhook/alert)
# and /health are exempt so TradingView and uptime checks keep working.
# NOTE: this is only strong once the site is on HTTPS — over plain http the code
# can be sniffed in transit. Treat it as a "keep randoms out" speed bump for now.
SITE_ACCESS_CODE=

# Browser CORS allowlist. Leave blank to allow all origins (current behaviour).
# Set to a comma-separated list to lock the API to your own front-end(s), e.g.
# ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:8081
ALLOWED_ORIGINS=

# Public demo deployment switch. When true, the server serves ONLY a sanitized,
# read-only surface (/health, /status/public, /share, static assets) and returns
# 404 for everything else (broker account, operator dashboard, manual controls,
# detailed status). Keep this FALSE on your private/operator box; turn it on only
# on a public-facing deployment that should never expose real account data.
PUBLIC_DEMO_MODE=false

# ─── HTTP Rate Limits ───────────────────────────────────────
PUBLIC_RATE_LIMIT_PER_MINUTE=120
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
PRIVATE_RATE_LIMIT_PER_MINUTE=240

# ─── Notifications (read-only, optional) ─────────────────────
# Discord is disabled by default. If enabled, it only reports paper decisions.
# Do not commit real Discord webhook URLs.
DISCORD_NOTIFICATIONS_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_DECISIONS=TRADE,RISK_REJECTED,BLOCKED_MAX_TRADES,BLOCKED_LOSS_LOCKOUT

# Optional Telegram alerts. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Signa API (optional read-only context) ───────────────────
# Uses Authorization: Bearer <SIGNA_API_KEY> against app.getsigna.ai.
# Failures are neutral and never block webhook processing.
# Default futures map: MES:SPY,ES:SPY,MNQ:QQQ,NQ:QQQ
SIGNA_API_ENABLED=false
SIGNA_API_KEY=
SIGNA_BASE_URL=https://app.getsigna.ai
SIGNA_TIMEOUT_SECONDS=3
SIGNA_SYMBOL_MAP=MES:SPY,ES:SPY,MNQ:QQQ,NQ:QQQ

# ─── GEX shadow analysis (optional read-only scorecards) ──────────────
# GEX_SHADOW_ANALYSIS_ENABLED exposes read-only scorecards in /status/today and
# /status/gex-shadow over journaled `gex_observed` snapshots vs resolved outcomes.
# It never changes trade gating.
GEX_SHADOW_ANALYSIS_ENABLED=false

# Observe-only GEX producer (computed in-house from the Public.com chain — needs
# PUBLIC_API_KEY + PUBLIC_ACCOUNT_ID below). Journals net GEX / gamma-flip / walls
# as `gex_observed` for the shadow analysis above. OBSERVE-ONLY — never gates.
# Maps the futures instrument to its tracking ETF for the chain (MNQ/NQ→QQQ,
# MES/ES→SPY). max_dte bounds how many near-term expiries are summed.
GEX_OBSERVE_ENABLED=false
GEX_OBSERVE_MAX_DTE=7
GEX_OBSERVE_SYMBOL_MAP=MNQ:QQQ,NQ:QQQ,MES:SPY,ES:SPY

# Observe-only range collector. When true, normal decision rows should carry
# wall_context and range evidence for PR #144's causal resolver to measure.
RANGE_OBSERVE_ENABLED=false

# Causal live resolver for journaled observe-only candidates (shadow_setups +
# range_signal lanes): each ingested bar resolves prior bars' candidates against
# the bars seen since and appends SHADOW_OUTCOME evidence rows to the journal.
# READ-ONLY for trading, fail-soft, additive rows only. On by default; false
# is the kill switch.
SHADOW_RESOLVER_ENABLED=true

# ─── Public.com API (optional read-only quotes) ─────────────
# Uses the official publicdotcom-py SDK. Quote checks require both values.
# This integration does not expose account, portfolio, or order operations.
PUBLIC_API_ENABLED=false
PUBLIC_API_SECRET_KEY=
PUBLIC_DEFAULT_ACCOUNT_NUMBER=


# ─── Broker Selection ────────────────────────────────────────
# Default to local paper simulation. Set BROKER=tradovate only for intentional
# broker-adapter testing after credentials and account permissions are verified.
BROKER=paper

# ─── Live Broker Adapters ───────────────────────────────────
# Tradovate key ID must be the numeric CID only; put the UUID in the secret.
# TRADOVATE_ENV=demo
# TRADOVATE_API_KEY_ID=
# TRADOVATE_API_KEY_SECRET=00000000-0000-0000-0000-000000000000
# TRADOVATE_USERNAME=
# TRADOVATE_PASSWORD=

# ─── Advisory Options Scanner (separate service) ─────────────
# Runs independently on port 8010. Advisory only; no order endpoints.
OPTIONS_MARKET_DATA_PROVIDER=public
TASTYTRADE_USERNAME=
TASTYTRADE_PASSWORD=
PUBLIC_API_KEY=
PUBLIC_BASE_URL=https://api.public.com
OPTIONS_SCANNER_PORT=8010
OPTIONS_SCANNER_DISCORD_WEBHOOK_URL=
OPTIONS_SCANNER_WATCHLIST=AAPL,MSFT,NVDA,TSLA,SPY,QQQ
OPTIONS_SCANNER_INTERVAL_MINUTES=5

# ─── Alpaca Options (future optional lane; disabled by default) ─────────
# Requires alpaca-py. This is intentionally separate from the futures PaperBroker path.
ALPACA_OPTIONS_ENABLED=false
ALPACA_PAPER=true
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_TIMEOUT_SECONDS=10

# ─── Companion Options Paper Lane (options_companion/) ───────────────────
# When a futures trade is fully approved + OPENED, derive an INTERNAL paper
# options trade (long-premium call/put on the matching ETF: MNQ/NQ->QQQ,
# MES/ES->SPY) using Signa as a stricter confirmation filter, tracked in a
# SEPARATE SQLite ledger. v1 places NO live or broker-paper options orders —
# it only consumes read-only Public chains/quotes for paper marks.
# Default OFF: a disabled lane changes nothing.
OPTIONS_COMPANION_ENABLED=false
OPTIONS_COMPANION_MODE=paper
OPTIONS_COMPANION_SQLITE_PATH=logs/options_companion.sqlite
# Reuses PUBLIC_API_KEY / PUBLIC_BASE_URL above. Public market-data is account-scoped
# (/userapigateway/marketdata/{accountId}/...), so the companion lane also needs the
# Public account number. Read-only: only the auth-token + marketdata paths are
# whitelisted, so order/trading endpoints are structurally unreachable.
PUBLIC_ACCOUNT_ID=

# ─── Advanced / runtime override knobs (ALL optional) ────────────────────
# Every key below is read by the code but has a built-in default (or a
# risk_rules.yaml fallback). Leave blank to keep the default. Documented here
# so this template lists every var the system reads. No real values belong in
# this file — it is committed to a public repo.

# Hard ceiling on contracts per order. Blank -> falls back to
# max_contracts_hard_cap in risk_rules.yaml (NOT unlimited).
MAX_CONTRACTS_HARD_CAP=

# Emergency manual-control endpoint (/webhook/manual: CLOSE_ALL / STATUS).
# Default false = endpoint returns 403. Keep OFF unless actively flattening.
ENABLE_MANUAL_EXECUTION_CONTROLS=false

# Discord heartbeat ping toggle (default true when notifications are on).
DISCORD_HEARTBEAT_ENABLED=true

# Live quote enrichment for status/decisions. Default true.
LIVE_QUOTE_ENABLED=true

# Enforce the Signa context gate on entries. Default false (advisory only).
SIGNA_GATE_ENFORCED=false

# Primary decision timeframe + drift guard. Blank -> code default.
PRIMARY_DECISION_TF=
EXPECTED_TIMEFRAME_MINUTES=

# Entry slippage tolerance (ticks). Per-instrument keys win over the generic.
ENTRY_SLIPPAGE_TOLERANCE_TICKS=
ENTRY_SLIPPAGE_TOLERANCE_TICKS_MES=
ENTRY_SLIPPAGE_TOLERANCE_TICKS_MNQ=

# Simulated fill slippage (ticks) for the PaperBroker path. Blank -> default.
FILL_SLIPPAGE_TICKS=

# VWAP-proximity gate (ticks). 0 disables the gate. Blank -> code default.
VWAP_ENTRY_MAX_DISTANCE_TICKS=

# Re-anchor eligible level entries to the live close. Blank/false -> disabled.
MOMENTUM_ENTRY_REANCHOR=false

# Authoritative exit contract used by replay, paper, and Tradovate:
# static | runner_shadow | runner_live. Default static.
EXIT_MODE=static
EXPECTED_PROOF_EXIT_MODE=<unset>
# Legacy observation flag remains accepted while deployments migrate to
# EXIT_MODE=runner_shadow.
RUNNER_SHADOW_ENABLED=false
# Entry fill model for REPLAY/PAPER only: market = legacy unconditional fills;
# ioc_limit mirrors the live Limit-IOC entry capped at entry ±
# ENTRY_SLIPPAGE_TOLERANCE_TICKS[_<ROOT>] (unset roots default to the live box
# values MES=16 / MNQ=32); stop_market arms a causal next-bar stop entry using
# the next bar open for gap-through fills. No-fill entries book CANCELLED and
# are not counted.
ENTRY_FILL_MODEL=market
RUNNER_ACTIVATION_R=1.0
RUNNER_TRAIL_R=0.5
# Legacy live flag remains accepted while deployments migrate to
# EXIT_MODE=runner_live. When active, the live Tradovate stop is moved
# in place (atomic /order/modifyorder, never-loosen, fail-safe) where the shadow
# trail says — turning the validated runner edge on for real. Tradovate path only.
# Leave false to keep static brackets; flip to true ONLY when supervised.
RUNNER_LIVE_ENABLED=false

# 5-minute entry feed. When true, a 5M TradingView alert is stored on its own
# lane (logs/tf5m/) and may trigger only an exact 15M setup previously validated
# but blocked as ENTRY_DETACHED_FROM_PRICE. Trigger requires a pullback through
# the original entry and a close back on its favorable side; the original
# bracket is unchanged. The 5M lane never evaluates strategy or re-anchors.
# Leave false to keep the 15M-only behaviour unchanged.
FIVE_MIN_FEED_ENABLED=false

# Advisory options scanner (separate service). Default off.
OPTIONS_SCANNER_ENABLED=false
OPTIONS_SCANNER_SQLITE_PATH=logs/options_scanner.sqlite

# Tastytrade options data base URL (alt provider; blank -> disabled).
TASTYTRADE_BASE_URL=
