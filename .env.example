# ============================================================
# Environment Configuration — Autonomous Futures Paper System
# ============================================================
# Copy this file to .env and review every value before running.
# NEVER commit .env to version control.
# ============================================================
STARTING_BALANCE=1500
HOST=0.0.0.0
PORT=80

# ─── Trading Mode (CRITICAL) ─────────────────────────────────
# DO NOT change to true in Phase 1. Doing so raises LiveTradingBlockedError.
LIVE_TRADING_ENABLED=false

# Paper mode must always be true in Phase 1
PAPER_MODE=true

# ─── System Settings ─────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=/app/logs
STARTING_BALANCE=1500

# Local default is 127.0.0.1:8000. Deployment platforms may set HOST/PORT.
HOST=127.0.0.1
PORT=8000

# Timezone for session detection (do not change)
SYSTEM_TZ=America/New_York

# ─── Risk Rules ──────────────────────────────────────────────
# Path to risk_rules.yaml (relative to project root)
RISK_RULES_PATH=risk_rules.yaml

# ─── Data Settings ───────────────────────────────────────────
# Maximum age of market state data in seconds (default 300 = 5 min)
MAX_DATA_STALENESS_SECONDS=300

# ─── Polygon.io / Massive (historical futures bars, optional) ─
# Free "Futures Basic" key from massive.com (polygon.io). Read-only
# historical bar backfill/backtest data only. Leave blank to disable.
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io

# ─── TradingView Webhook ─────────────────────────────────────
# Required to start the server. The inbound secret can be supplied three ways,
# in order of preference:
#   1. X-Webhook-Secret request header (most private)
#   2. a "secret" field inside the JSON body (TradingView templates support this)
#   3. ?secret=... URL query param (works, but leaks into access logs — see below)
# Use a unique local value. This is not a broker credential.
WEBHOOK_SECRET=

# Allow the secret to travel as a ?secret= URL query param. On by default so
# existing TradingView alerts keep working. Once your alert sends the secret in
# the body (or via a header), set this to false to close the log-leak path.
ALLOW_SECRET_IN_QUERY=true

# ─── Web Exposure / Security ─────────────────────────────────
# Simple site access code. Leave blank to disable (anyone can open the site).
# When set, visitors must enter this exact code once; it is then remembered in a
# cookie. No code = the site can't be opened. Webhook ingestion (/webhook/alert)
# and /health are exempt so TradingView and uptime checks keep working.
# NOTE: this is only strong once the site is on HTTPS — over plain http the code
# can be sniffed in transit. Treat it as a "keep randoms out" speed bump for now.
SITE_ACCESS_CODE=

# Browser CORS allowlist. Leave blank to allow all origins (current behaviour).
# Set to a comma-separated list to lock the API to your own front-end(s), e.g.
# ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:8081
ALLOWED_ORIGINS=

# Public demo deployment switch. When true, the server serves ONLY a sanitized,
# read-only surface (/health, /status/public, /share, static assets) and returns
# 404 for everything else (broker account, operator dashboard, manual controls,
# detailed status). Keep this FALSE on your private/operator box; turn it on only
# on a public-facing deployment that should never expose real account data.
PUBLIC_DEMO_MODE=false

# ─── HTTP Rate Limits ───────────────────────────────────────
PUBLIC_RATE_LIMIT_PER_MINUTE=120
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
PRIVATE_RATE_LIMIT_PER_MINUTE=240

# ─── Notifications (read-only, optional) ─────────────────────
# Discord is disabled by default. If enabled, it only reports paper decisions.
# Do not commit real Discord webhook URLs.
DISCORD_NOTIFICATIONS_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_DECISIONS=TRADE,RISK_REJECTED,BLOCKED_MAX_TRADES,BLOCKED_LOSS_LOCKOUT
DISCORD_HEARTBEAT_ENABLED=false

# Optional Telegram alerts. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Signa API (optional read-only context) ───────────────────
# Uses Authorization: Bearer <SIGNA_API_KEY> against app.getsigna.ai.
# Failures are neutral and never block webhook processing.
# Default futures map: MES:SPY,ES:SPY,MNQ:QQQ,NQ:QQQ
SIGNA_API_ENABLED=false
SIGNA_API_KEY=
SIGNA_BASE_URL=https://app.getsigna.ai
SIGNA_TIMEOUT_SECONDS=3
SIGNA_SYMBOL_MAP=MES:SPY,ES:SPY,MNQ:QQQ,NQ:QQQ

# ─── Public.com API (optional read-only quotes) ─────────────
# Uses the official publicdotcom-py SDK. Quote checks require both values.
# This integration does not expose account, portfolio, or order operations.
PUBLIC_API_ENABLED=false
PUBLIC_API_SECRET_KEY=
PUBLIC_DEFAULT_ACCOUNT_NUMBER=


# ─── Broker Selection ────────────────────────────────────────
# Default to local paper simulation. Set BROKER=tradovate only for intentional
# broker-adapter testing after credentials and account permissions are verified.
BROKER=paper

# ─── Live Broker Adapters ───────────────────────────────────
# Tradovate key ID must be the numeric CID only; put the UUID in the secret.
# TRADOVATE_ENV=demo
# TRADOVATE_API_KEY_ID=13833
# TRADOVATE_API_KEY_SECRET=00000000-0000-0000-0000-000000000000
# TRADOVATE_USERNAME=
# TRADOVATE_PASSWORD=

# ─── Advisory Options Scanner (separate service) ─────────────
# Runs independently on port 8010. Advisory only; no order endpoints.
OPTIONS_MARKET_DATA_PROVIDER=public
TASTYTRADE_USERNAME=
TASTYTRADE_PASSWORD=
PUBLIC_API_KEY=
PUBLIC_BASE_URL=https://api.public.com
OPTIONS_SCANNER_PORT=8010
OPTIONS_SCANNER_DISCORD_WEBHOOK_URL=
OPTIONS_SCANNER_WATCHLIST=AAPL,MSFT,NVDA,TSLA,SPY,QQQ
OPTIONS_SCANNER_INTERVAL_MINUTES=5

# ─── Alpaca Options (future optional lane; disabled by default) ─────────
# Requires alpaca-py. This is intentionally separate from the futures PaperBroker path.
ALPACA_OPTIONS_ENABLED=false
ALPACA_PAPER=true
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_TIMEOUT_SECONDS=10
