  "fieldGlossary": {
    "netGEX": "Net Gamma Exposure in notional dollars. Positive = dealers long gamma (stabilizing, mean-reversion). Negative = dealers short gamma (amplifying, trend-following).",
    "flipPoint": "Price level where dealer gamma flips from positive to negative. THE key structural level.",
    "distToFlip": "Spot price distance from flip point as a percentage. Near zero = high-volatility flip zone.",
    "regime": "Gamma regime classification: 'positive' (stabilizing), 'negative' (amplifying), 'flip_zone' (at the flip — unpredictable).",
    "netDEX": "Net Delta Exposure in notional dollars. Positive = dealers long delta (bullish pressure). Negative = short delta (bearish).",
    "netVEX": "Net Vanna Exposure. Measures dealer sensitivity to implied volatility changes — vanna gravity pockets.",
    "chexRegime": "Charm Exposure regime: 'HIGH_PINNING' (time decay pins price), 'DESTABILIZING' (decay amplifies moves), 'stable'.",
    "chexMagnitude": "Absolute magnitude of charm exposure — how strongly time decay is influencing positioning.",
    "conviction": "Wall conviction score (0–100). Measures how well-backed a gamma wall is by OI, volume, and premium. FORTRESS (85+), STRONG (65+), MOD (40+), WEAK (<40).",
    "0dteShare": "Fraction of a strike's gamma from today's expiration. >0.7 = mostly 0DTE gamma (evaporates tomorrow). <0.2 = structural (persists).",
    "firstGapAbove / firstGapBelow": "First 'air pocket' — a run of consecutive low-gamma strikes where price can accelerate through without dealer resistance.",
    "surface": "Spatial GEX/VEX map: top nodes above and below spot, ranked by magnitude. Shows where dealer exposure is concentrated and where the gaps are.",
    "velocity": "Rate of change between consecutive 60-second snapshots. Shows how fast dealer positioning is shifting in real time.",
    "impliedMove": "0DTE ATM straddle-derived expected move. upperBand/lowerBand = spot ± implied move.",
    "strikeGEX": "Per-strike net GEX lookup table. Keys are strike prices, values are net gamma exposure at that strike.",
    "snapshotAge": "Milliseconds since the snapshot was collected. Typically 0–60000ms during market hours.",
    "source": "'database' = cached 60-second snapshot (fast). 'fallback' = live-fetched for out-of-coverage tickers (slower, 1–3s).",
    "processingMs": "Server-side processing time in milliseconds. Typically sub-50ms."
  }
}
